/.local/
/.ipynb_checkpoints/
/artifacts_reproduced*/

# Веса, кеши и промежуточные прогоны хранятся локально.
/artifacts/**/*.safetensors
/artifacts/baseline/
/artifacts/student_trials/
/artifacts/quantization_logs/
*.log

# Конфиги и индексы выбранных чекпоинтов входят в сдачу.
!/artifacts/quantized/*/model.safetensors.index.json
!/artifacts/student_sft/model.safetensors.index.json
/artifacts/quantized/*/added_tokens.json
/artifacts/quantized/*/chat_template.jinja
/artifacts/quantized/*/merges.txt
/artifacts/quantized/*/special_tokens_map.json
/artifacts/quantized/*/tokenizer*.json
/artifacts/quantized/*/vocab.json
/artifacts/student_sft/added_tokens.json
/artifacts/student_sft/chat_template.jinja
/artifacts/student_sft/merges.txt
/artifacts/student_sft/special_tokens_map.json
/artifacts/student_sft/tokenizer*.json
/artifacts/student_sft/training_args.bin
/artifacts/student_sft/vocab.json
